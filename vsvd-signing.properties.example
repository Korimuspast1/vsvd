# Copy to vsvd-signing.properties (ignored by Git) before a release build.
# The keystore path is relative to the VSVD repository root.
VSVD_RELEASE_STORE_FILE=signing/vsvd-release.p12
VSVD_RELEASE_STORE_TYPE=PKCS12
VSVD_RELEASE_STORE_PASSWORD=
VSVD_RELEASE_KEY_ALIAS=vsvd
VSVD_RELEASE_KEY_PASSWORD=
