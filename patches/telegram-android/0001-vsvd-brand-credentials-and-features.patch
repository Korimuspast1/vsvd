--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdBadgeDrawable.java
@@ -0,0 +1,78 @@
+/*
+ * VSVD additions to the Telegram Android GPLv2-or-later codebase.
+ */
+package org.telegram.vsvd;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import org.telegram.messenger.AndroidUtilities;
+
+/** A compact, text-only badge used beside a user name in VSVD-owned surfaces. */
+public final class VsvdBadgeDrawable extends Drawable {
+
+    private final VsvdBadge badge;
+    private final Paint backgroundPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint textPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+    private final int intrinsicWidth;
+    private final int intrinsicHeight;
+
+    public VsvdBadgeDrawable(VsvdBadge badge) {
+        this.badge = badge;
+        backgroundPaint.setColor(badge.backgroundColor);
+        textPaint.setColor(badge.textColor);
+        textPaint.setTextSize(AndroidUtilities.dp(9));
+        textPaint.setTypeface(AndroidUtilities.bold());
+        intrinsicHeight = AndroidUtilities.dp(17);
+        intrinsicWidth = Math.max(AndroidUtilities.dp(24), (int) Math.ceil(textPaint.measureText(badge.label)) + AndroidUtilities.dp(12));
+    }
+
+    @Override
+    public void draw(@NonNull Canvas canvas) {
+        Rect bounds = getBounds();
+        rect.set(bounds.left, bounds.top, bounds.right, bounds.bottom);
+        float radius = rect.height() / 2f;
+        canvas.drawRoundRect(rect, radius, radius, backgroundPaint);
+        Paint.FontMetrics metrics = textPaint.getFontMetrics();
+        float baseline = rect.centerY() - (metrics.ascent + metrics.descent) / 2f;
+        canvas.drawText(badge.label, rect.centerX() - textPaint.measureText(badge.label) / 2f, baseline, textPaint);
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        backgroundPaint.setAlpha(alpha);
+        textPaint.setAlpha(alpha);
+        invalidateSelf();
+    }
+
+    @Override
+    public void setColorFilter(@Nullable ColorFilter colorFilter) {
+        backgroundPaint.setColorFilter(colorFilter);
+        textPaint.setColorFilter(colorFilter);
+        invalidateSelf();
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+
+    @Override
+    public int getIntrinsicWidth() {
+        return intrinsicWidth;
+    }
+
+    @Override
+    public int getIntrinsicHeight() {
+        return intrinsicHeight;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdBadgeStore.java b/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdBadgeStore.java
new file mode 100644
index 0000000000000000000000000000000000000000..af1e3d08acf60648110af33ebdc2e5716a99a399
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdBadgeStore.java
@@ -0,0 +1,102 @@
+/*
+ * VSVD additions to the Telegram Android GPLv2-or-later codebase.
+ */
+package org.telegram.vsvd;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Stores VSVD badge snapshots in the app sandbox.
+ *
+ * This class intentionally has no networking capability. The Control Plane
+ * client validates HTTPS, response schema and recipient ID before calling
+ * replace(); response signatures will be required before public distribution.
+ * Telegram user IDs are used only as local lookup keys and no chat/message data
+ * belongs in this store.
+ */
+public final class VsvdBadgeStore {
+
+    private static final String PREFERENCES = "vsvd.badges.v1";
+    private static final String KEY_PREFIX = "badges.";
+
+    private VsvdBadgeStore() {
+    }
+
+    public static List<VsvdBadge> get(Context context, int account, long telegramUserId) {
+        if (telegramUserId == 0) {
+            return Collections.emptyList();
+        }
+        String raw = preferences(context).getString(key(account, telegramUserId), "");
+        if (raw.isEmpty()) {
+            return Collections.emptyList();
+        }
+        try {
+            JSONArray saved = new JSONArray(raw);
+            long now = System.currentTimeMillis();
+            ArrayList<VsvdBadge> badges = new ArrayList<>();
+            for (int i = 0; i < saved.length(); i++) {
+                VsvdBadge badge = VsvdBadge.fromJson(saved.getJSONObject(i));
+                if (badge.isActive(now)) {
+                    badges.add(badge);
+                }
+            }
+            return Collections.unmodifiableList(badges);
+        } catch (JSONException | IllegalArgumentException ignored) {
+            // Corrupt or untrusted local metadata is discarded instead of shown.
+            clear(context, account, telegramUserId);
+            return Collections.emptyList();
+        }
+    }
+
+    public static VsvdBadge getPrimary(Context context, int account, long telegramUserId, VsvdBadge.Scope scope) {
+        for (VsvdBadge badge : get(context, account, telegramUserId)) {
+            if (badge.isVisibleIn(scope)) {
+                return badge;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * Persist an entire validated grant snapshot for one linked Telegram user.
+     * Callers must check HTTPS, response schema, recipient ID and expiry before
+     * invoking this method; release builds will also require a server signature.
+     */
+    public static void replace(Context context, int account, long telegramUserId, List<VsvdBadge> verifiedBadges) {
+        if (telegramUserId == 0 || verifiedBadges == null) {
+            return;
+        }
+        JSONArray serialized = new JSONArray();
+        try {
+            for (VsvdBadge badge : verifiedBadges) {
+                if (badge != null && badge.isActive(System.currentTimeMillis())) {
+                    serialized.put(badge.toJson());
+                }
+            }
+            preferences(context).edit().putString(key(account, telegramUserId), serialized.toString()).apply();
+        } catch (JSONException ignored) {
+            // Atomic replacement: preserve the previously verified snapshot.
+        }
+    }
+
+    public static void clear(Context context, int account, long telegramUserId) {
+        preferences(context).edit().remove(key(account, telegramUserId)).apply();
+    }
+
+    private static SharedPreferences preferences(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFERENCES, Context.MODE_PRIVATE);
+    }
+
+    private static String key(int account, long telegramUserId) {
+        return KEY_PREFIX + account + "." + telegramUserId;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdControlPlaneClient.java b/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdControlPlaneClient.java
new file mode 100644
index 0000000000000000000000000000000000000000..48b05d2e2d12db6a66c81c7bb272f72021c50f28
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdControlPlaneClient.java
@@ -0,0 +1,119 @@
+/*
+ * VSVD additions to the Telegram Android GPLv2-or-later codebase.
+ */
+package org.telegram.vsvd;
+
+import android.content.Context;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+
+import java.io.BufferedInputStream;
+import java.io.ByteArrayOutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Reads only the public badge snapshot for the account currently using VSVD.
+ * It never uploads Telegram messages, contacts, phone numbers, codes or session
+ * material to the Control Plane.
+ */
+public final class VsvdControlPlaneClient {
+
+    private static final int CONNECT_TIMEOUT_MS = 8_000;
+    private static final int READ_TIMEOUT_MS = 10_000;
+
+    public interface SyncCallback {
+        void onSuccess(int activeBadgeCount);
+        void onFailure(String reason);
+    }
+
+    private VsvdControlPlaneClient() {
+    }
+
+    public static void syncBadges(Context context, int account, long telegramUserId, SyncCallback callback) {
+        final Context appContext = context.getApplicationContext();
+        final String baseUrl = VsvdSettings.getControlPlaneUrl(appContext);
+        if (!VsvdSettings.isControlPlaneEnabled(appContext)) {
+            notifyFailure(callback, "Control Plane is disabled or not configured");
+            return;
+        }
+        if (telegramUserId == 0) {
+            notifyFailure(callback, "Telegram user ID is not available");
+            return;
+        }
+        new Thread(() -> fetchBadges(appContext, baseUrl, account, telegramUserId, callback), "VSVD-badge-sync").start();
+    }
+
+    private static void fetchBadges(Context context, String baseUrl, int account, long telegramUserId, SyncCallback callback) {
+        HttpURLConnection connection = null;
+        try {
+            URL url = new URL(baseUrl + "/api/v1/badges/users/" + telegramUserId);
+            connection = (HttpURLConnection) url.openConnection();
+            connection.setRequestMethod("GET");
+            connection.setConnectTimeout(CONNECT_TIMEOUT_MS);
+            connection.setReadTimeout(READ_TIMEOUT_MS);
+            connection.setRequestProperty("Accept", "application/json");
+            connection.setRequestProperty("User-Agent", "VSVD-Android-BadgeSync/1");
+            int status = connection.getResponseCode();
+            if (status != HttpURLConnection.HTTP_OK) {
+                throw new IllegalStateException("Control Plane returned HTTP " + status);
+            }
+            String body = readFully(connection);
+            JSONObject response = new JSONObject(body);
+            if (response.optInt("schemaVersion", 0) != 1 || !Long.toString(telegramUserId).equals(response.optString("telegramUserId"))) {
+                throw new IllegalStateException("Control Plane returned an invalid badge snapshot");
+            }
+            JSONArray serializedBadges = response.optJSONArray("badges");
+            if (serializedBadges == null) {
+                throw new IllegalStateException("Control Plane did not return a badge array");
+            }
+            List<VsvdBadge> badges = new ArrayList<>();
+            for (int i = 0; i < serializedBadges.length(); i++) {
+                badges.add(VsvdBadge.fromJson(serializedBadges.getJSONObject(i)));
+            }
+            VsvdBadgeStore.replace(context, account, telegramUserId, badges);
+            int count = VsvdBadgeStore.get(context, account, telegramUserId).size();
+            AndroidUtilities.runOnUIThread(() -> callback.onSuccess(count));
+        } catch (Exception error) {
+            notifyFailure(callback, safeMessage(error));
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    private static String readFully(HttpURLConnection connection) throws Exception {
+        try (BufferedInputStream input = new BufferedInputStream(connection.getInputStream());
+             ByteArrayOutputStream output = new ByteArrayOutputStream()) {
+            byte[] buffer = new byte[4_096];
+            int read;
+            int total = 0;
+            while ((read = input.read(buffer)) != -1) {
+                total += read;
+                if (total > 128 * 1024) {
+                    throw new IllegalStateException("Badge response is too large");
+                }
+                output.write(buffer, 0, read);
+            }
+            return output.toString(StandardCharsets.UTF_8.name());
+        }
+    }
+
+    private static void notifyFailure(SyncCallback callback, String reason) {
+        AndroidUtilities.runOnUIThread(() -> callback.onFailure(reason));
+    }
+
+    private static String safeMessage(Exception error) {
+        String message = error.getMessage();
+        if (message == null || message.length() > 120) {
+            return "Unable to update badges";
+        }
+        return message;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdPluginPolicy.java b/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdPluginPolicy.java
new file mode 100644
index 0000000000000000000000000000000000000000..f465640750cf183bbde71249fab408cdbf0eb2e7
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdPluginPolicy.java
@@ -0,0 +1,73 @@
+/*
+ * VSVD additions to the Telegram Android GPLv2-or-later codebase.
+ */
+package org.telegram.vsvd;
+
+import java.util.Collections;
+import java.util.EnumSet;
+import java.util.Set;
+
+/**
+ * The first VSVD plugin runtime accepts signed declarative packages only.
+ * Dynamic APK, DEX, native libraries and arbitrary script engines are outside
+ * this contract by design.
+ */
+public final class VsvdPluginPolicy {
+
+    public enum Capability {
+        THEME,
+        MESSAGE_DECORATION,
+        CHAT_ACTION,
+        LOCAL_AUTOMATION,
+        NETWORK_REQUEST
+    }
+
+    private static final Set<Capability> PERMITTED = Collections.unmodifiableSet(
+        EnumSet.of(
+            Capability.THEME,
+            Capability.MESSAGE_DECORATION,
+            Capability.CHAT_ACTION,
+            Capability.LOCAL_AUTOMATION
+        )
+    );
+
+    private VsvdPluginPolicy() {
+    }
+
+    public static Validation validate(String id, int minClientVersion, int currentClientVersion, String publisherKeyId, String signature, Set<Capability> capabilities, Set<String> trustedPublisherKeys) {
+        if (id == null || !id.matches("[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*")) {
+            return Validation.reject("invalid_plugin_id");
+        }
+        if (minClientVersion > currentClientVersion) {
+            return Validation.reject("client_update_required");
+        }
+        if (publisherKeyId == null || trustedPublisherKeys == null || !trustedPublisherKeys.contains(publisherKeyId)) {
+            return Validation.reject("untrusted_publisher");
+        }
+        if (signature == null || signature.isEmpty()) {
+            return Validation.reject("missing_signature");
+        }
+        if (capabilities == null || !PERMITTED.containsAll(capabilities)) {
+            return Validation.reject("capability_not_allowed");
+        }
+        return Validation.accept();
+    }
+
+    public static final class Validation {
+        public final boolean accepted;
+        public final String reason;
+
+        private Validation(boolean accepted, String reason) {
+            this.accepted = accepted;
+            this.reason = reason;
+        }
+
+        private static Validation accept() {
+            return new Validation(true, "");
+        }
+
+        private static Validation reject(String reason) {
+            return new Validation(false, reason);
+        }
+    }
+}
