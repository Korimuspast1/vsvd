diff --git a/TMessagesProj/src/main/java/org/telegram/ui/VsvdClientSettingsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/VsvdClientSettingsActivity.java
new file mode 100644
index 0000000000000000000000000000000000000000..831ca6572b3c0695370db48af1362a58abdfed83
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/VsvdClientSettingsActivity.java
@@ -0,0 +1,235 @@
+/*
+ * VSVD additions to the Telegram Android GPLv2-or-later codebase.
+ */
+package org.telegram.ui;
+
+import android.content.Context;
+import android.text.InputType;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.R;
+import org.telegram.messenger.UserConfig;
+import org.telegram.ui.ActionBar.ActionBar;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Cells.HeaderCell;
+import org.telegram.ui.Cells.TextCheckCell;
+import org.telegram.ui.Cells.TextInfoPrivacyCell;
+import org.telegram.ui.Cells.TextSettingsCell;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.RecyclerListView;
+import org.telegram.vsvd.VsvdBadgeStore;
+import org.telegram.vsvd.VsvdControlPlaneClient;
+import org.telegram.vsvd.VsvdSettings;
+
+/** VSVD-owned settings surfaced from the real Telegram Settings screen. */
+public class VsvdClientSettingsActivity extends BaseFragment {
+
+    private static final int TYPE_HEADER = 0;
+    private static final int TYPE_CHECK = 1;
+    private static final int TYPE_VALUE = 2;
+    private static final int TYPE_INFO = 3;
+
+    private static final int ROW_CLIENT_HEADER = 0;
+    private static final int ROW_SHOW_BADGES = 1;
+    private static final int ROW_SYNC_BADGES = 2;
+    private static final int ROW_USER_ID = 3;
+    private static final int ROW_BADGES_INFO = 4;
+    private static final int ROW_SERVER_HEADER = 5;
+    private static final int ROW_SERVER_ENABLED = 6;
+    private static final int ROW_SERVER_URL = 7;
+    private static final int ROW_SERVER_INFO = 8;
+    private static final int ROW_PLUGINS_HEADER = 9;
+    private static final int ROW_PLUGINS_ENABLED = 10;
+    private static final int ROW_PLUGINS_INFO = 11;
+    private static final int ROW_COUNT = 12;
+
+    private final int targetAccount;
+    private RecyclerListView listView;
+    private ListAdapter adapter;
+
+    public VsvdClientSettingsActivity(int account) {
+        targetAccount = account;
+    }
+
+    @Override
+    public View createView(Context context) {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setAllowOverlayTitle(true);
+        actionBar.setTitle("VSVD Client Settings");
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) {
+                    finishFragment();
+                }
+            }
+        });
+
+        FrameLayout frameLayout = new FrameLayout(context);
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+        fragmentView = frameLayout;
+
+        listView = new RecyclerListView(context);
+        listView.setSections();
+        actionBar.setAdaptiveBackground(listView);
+        listView.setLayoutManager(new LinearLayoutManager(context));
+        listView.setVerticalScrollBarEnabled(false);
+        listView.setAdapter(adapter = new ListAdapter(context));
+        listView.setOnItemClickListener((view, position) -> onRowClicked(context, position));
+        frameLayout.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        return fragmentView;
+    }
+
+    private void onRowClicked(Context context, int position) {
+        if (position == ROW_SHOW_BADGES) {
+            VsvdSettings.setBadgesVisible(context, !VsvdSettings.areBadgesVisible(context));
+            adapter.notifyItemChanged(position);
+        } else if (position == ROW_SERVER_ENABLED) {
+            VsvdSettings.setControlPlaneEnabled(context, !VsvdSettings.isControlPlaneEnabled(context));
+            adapter.notifyDataSetChanged();
+        } else if (position == ROW_SERVER_URL) {
+            showServerUrlDialog(context);
+        } else if (position == ROW_SYNC_BADGES) {
+            long userId = UserConfig.getInstance(targetAccount).getClientUserId();
+            Toast.makeText(context, "VSVD: обновляем бейджи…", Toast.LENGTH_SHORT).show();
+            VsvdControlPlaneClient.syncBadges(context, targetAccount, userId, new VsvdControlPlaneClient.SyncCallback() {
+                @Override
+                public void onSuccess(int activeBadgeCount) {
+                    Toast.makeText(context, "VSVD: активных бейджей — " + activeBadgeCount, Toast.LENGTH_LONG).show();
+                    adapter.notifyDataSetChanged();
+                }
+
+                @Override
+                public void onFailure(String reason) {
+                    Toast.makeText(context, "VSVD: " + reason, Toast.LENGTH_LONG).show();
+                }
+            });
+        } else if (position == ROW_PLUGINS_ENABLED) {
+            VsvdSettings.setPluginRuntimeEnabled(context, !VsvdSettings.isPluginRuntimeEnabled(context));
+            adapter.notifyItemChanged(position);
+        }
+    }
+
+    private void showServerUrlDialog(Context context) {
+        EditText input = new EditText(context);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        input.setSingleLine(true);
+        input.setText(VsvdSettings.getControlPlaneUrl(context));
+        input.setSelectAllOnFocus(false);
+        input.setHint("https://control.example.com");
+        input.setPadding(AndroidUtilities.dp(24), 0, AndroidUtilities.dp(24), 0);
+        AlertDialog dialog = new AlertDialog.Builder(getParentActivity())
+            .setTitle("VSVD Control Plane URL")
+            .setView(input)
+            .setNegativeButton("Отмена", null)
+            .setPositiveButton("Сохранить", null)
+            .create();
+        dialog.setOnShowListener(ignored -> dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener(view -> {
+            try {
+                VsvdSettings.setControlPlaneUrl(context, input.getText().toString());
+                adapter.notifyDataSetChanged();
+                dialog.dismiss();
+            } catch (IllegalArgumentException error) {
+                input.setError("Укажи корректный HTTPS URL");
+            }
+        }));
+        showDialog(dialog);
+    }
+
+    private class ListAdapter extends RecyclerListView.SelectionAdapter {
+        private final Context context;
+
+        private ListAdapter(Context context) {
+            this.context = context;
+        }
+
+        @Override
+        public int getItemCount() {
+            return ROW_COUNT;
+        }
+
+        @Override
+        public boolean isEnabled(RecyclerView.ViewHolder holder) {
+            int position = holder.getAdapterPosition();
+            return position == ROW_SHOW_BADGES || position == ROW_SYNC_BADGES || position == ROW_SERVER_ENABLED ||
+                position == ROW_SERVER_URL || position == ROW_PLUGINS_ENABLED;
+        }
+
+        @NonNull
+        @Override
+        public RecyclerView.ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+            View view;
+            if (viewType == TYPE_HEADER) {
+                view = new HeaderCell(context);
+            } else if (viewType == TYPE_CHECK) {
+                view = new TextCheckCell(context);
+            } else if (viewType == TYPE_VALUE) {
+                view = new TextSettingsCell(context);
+            } else {
+                view = new TextInfoPrivacyCell(context);
+            }
+            view.setLayoutParams(new RecyclerView.LayoutParams(
+                RecyclerView.LayoutParams.MATCH_PARENT,
+                RecyclerView.LayoutParams.WRAP_CONTENT
+            ));
+            return new RecyclerListView.Holder(view);
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull RecyclerView.ViewHolder holder, int position) {
+            int type = holder.getItemViewType();
+            if (type == TYPE_HEADER) {
+                HeaderCell cell = (HeaderCell) holder.itemView;
+                cell.setText(position == ROW_CLIENT_HEADER ? "Клиент VSVD" : position == ROW_SERVER_HEADER ? "VSVD Control Plane" : "Плагины VSVD");
+            } else if (type == TYPE_CHECK) {
+                TextCheckCell cell = (TextCheckCell) holder.itemView;
+                if (position == ROW_SHOW_BADGES) {
+                    cell.setTextAndCheck("Показывать кастомные бейджи", VsvdSettings.areBadgesVisible(context), true);
+                } else if (position == ROW_SERVER_ENABLED) {
+                    cell.setTextAndCheck("Включить синхронизацию бейджей", VsvdSettings.isControlPlaneEnabled(context), true);
+                } else {
+                    cell.setTextAndCheck("Включить декларативные плагины", VsvdSettings.isPluginRuntimeEnabled(context), false);
+                }
+            } else if (type == TYPE_VALUE) {
+                TextSettingsCell cell = (TextSettingsCell) holder.itemView;
+                if (position == ROW_SYNC_BADGES) {
+                    cell.setTextAndValue("Синхронизировать мои бейджи", "Сейчас", true);
+                } else if (position == ROW_USER_ID) {
+                    cell.setTextAndValue("Мой Telegram User ID", Long.toString(UserConfig.getInstance(targetAccount).getClientUserId()), false);
+                } else {
+                    String url = VsvdSettings.getControlPlaneUrl(context);
+                    cell.setTextAndValue("Адрес сервера", url.isEmpty() ? "Не задан" : url, false);
+                }
+            } else {
+                TextInfoPrivacyCell cell = (TextInfoPrivacyCell) holder.itemView;
+                if (position == ROW_BADGES_INFO) {
+                    int count = VsvdBadgeStore.get(context, targetAccount, UserConfig.getInstance(targetAccount).getClientUserId()).size();
+                    cell.setText("Бейджей в локальном кэше: " + count + ". Они видны только в VSVD и не передаются через Telegram.");
+                } else if (position == ROW_SERVER_INFO) {
+                    cell.setText("Сервер получает только запрос за публичным списком бейджей по вашему User ID. Он не видит сообщения, медиа, номер телефона или Telegram-сессию.");
+                } else {
+                    cell.setText("Первый runtime принимает только подписанные пакеты с темами и декларативными действиями. APK, DEX, нативный код и скрипты запрещены.");
+                }
+            }
+        }
+
+        @Override
+        public int getItemViewType(int position) {
+            if (position == ROW_CLIENT_HEADER || position == ROW_SERVER_HEADER || position == ROW_PLUGINS_HEADER) return TYPE_HEADER;
+            if (position == ROW_SHOW_BADGES || position == ROW_SERVER_ENABLED || position == ROW_PLUGINS_ENABLED) return TYPE_CHECK;
+            if (position == ROW_SYNC_BADGES || position == ROW_USER_ID || position == ROW_SERVER_URL) return TYPE_VALUE;
+            return TYPE_INFO;
+        }
+    }
+}
