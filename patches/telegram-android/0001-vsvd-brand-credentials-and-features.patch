+/*
+ * VSVD additions to the Telegram Android GPLv2-or-later codebase.
+ * A VSVD badge is local presentation metadata. It is never sent through the
+ * Telegram protocol and is visible only in VSVD.
+ */
+package org.telegram.vsvd;
+
+import android.graphics.Color;
+import android.text.TextUtils;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+public final class VsvdBadge {
+
+    public enum Scope {
+        PROFILE,
+        USER_LIST,
+        MESSAGE_HEADER
+    }
+
+    public final String id;
+    public final String label;
+    public final int backgroundColor;
+    public final int textColor;
+    public final long expiresAtMillis;
+    public final Scope[] scopes;
+
+    public VsvdBadge(String id, String label, int backgroundColor, int textColor, long expiresAtMillis, Scope[] scopes) {
+        if (TextUtils.isEmpty(id) || !id.matches("[a-z][a-z0-9.-]{1,63}")) {
+            throw new IllegalArgumentException("Badge id is invalid");
+        }
+        if (TextUtils.isEmpty(label) || label.length() > 20) {
+            throw new IllegalArgumentException("Badge label is invalid");
+        }
+        this.id = id;
+        this.label = label;
+        this.backgroundColor = backgroundColor;
+        this.textColor = textColor;
+        this.expiresAtMillis = expiresAtMillis;
+        this.scopes = scopes == null || scopes.length == 0 ? new Scope[] { Scope.PROFILE } : scopes.clone();
+    }
+
+    public boolean isActive(long nowMillis) {
+        return expiresAtMillis <= 0 || expiresAtMillis > nowMillis;
+    }
+
+    public boolean isVisibleIn(Scope expectedScope) {
+        for (Scope scope : scopes) {
+            if (scope == expectedScope) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public JSONObject toJson() throws JSONException {
+        JSONObject json = new JSONObject();
+        json.put("id", id);
+        json.put("label", label);
+        json.put("background", String.format("#%08X", backgroundColor));
+        json.put("text", String.format("#%08X", textColor));
+        json.put("expiresAt", expiresAtMillis);
+        StringBuilder scopeNames = new StringBuilder();
+        for (Scope scope : scopes) {
+            if (scopeNames.length() > 0) {
+                scopeNames.append(',');
+            }
+            scopeNames.append(scope.name());
+        }
+        json.put("scopes", scopeNames.toString());
+        return json;
+    }
+
+    public static VsvdBadge fromJson(JSONObject json) throws JSONException {
+        String id = json.getString("id");
+        String label = json.getString("label");
+        int background = Color.parseColor(json.optString("background", "#FF336699"));
+        int text = Color.parseColor(json.optString("text", "#FFFFFFFF"));
+        long expiresAt = json.optLong("expiresAt", 0L);
+        String[] names = json.optString("scopes", "PROFILE").split(",");
+        Scope[] scopes = new Scope[names.length];
+        for (int i = 0; i < names.length; i++) {
+            try {
+                scopes[i] = Scope.valueOf(names[i]);
+            } catch (IllegalArgumentException ignored) {
+                scopes[i] = Scope.PROFILE;
+            }
+        }
+        return new VsvdBadge(id, label, background, text, expiresAt, scopes);
+    }
+}
