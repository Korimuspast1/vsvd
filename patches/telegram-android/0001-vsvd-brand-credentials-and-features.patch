+// VSVD owns a separate Telegram API application. Credentials are loaded only
+// from the checkout parent (ignored by Git) or CI environment variables; they
+// must never be written to a committed Gradle file or sent to VSVD services.
+def vsvdCredentials = new Properties()
+def vsvdCredentialsFile = new File(rootProject.projectDir.parentFile, "telegram.properties")
+if (vsvdCredentialsFile.exists()) {
+    vsvdCredentialsFile.withInputStream { vsvdCredentials.load(it) }
+}
+def vsvdApiIdRaw = vsvdCredentials.getProperty("TELEGRAM_API_ID", System.getenv("VSVD_TELEGRAM_API_ID") ?: "0").trim()
+def vsvdApiHash = vsvdCredentials.getProperty("TELEGRAM_API_HASH", System.getenv("VSVD_TELEGRAM_API_HASH") ?: "").trim()
+def vsvdApiId = vsvdApiIdRaw.isInteger() ? vsvdApiIdRaw.toInteger() : 0
+if (vsvdApiId <= 0 || vsvdApiHash.isEmpty()) {
+    logger.warn("VSVD: Telegram API credentials are not configured. Copy telegram.properties.example to ../telegram.properties before signing in.")
+}
+def vsvdApiHashForBuildConfig = vsvdApiHash.replace("\\", "\\\\").replace("\"", "\\\"")
+
