diff --git a/TMessagesProj_App/build.gradle b/TMessagesProj_App/build.gradle
index ea7a853af51b8e9d49af22c59e77796427e5df67..32dc3d7f8dbacb4831d7a4b8b04c4688f03c8e13 100644
--- a/TMessagesProj_App/build.gradle
+++ b/TMessagesProj_App/build.gradle
@@ -3,0 +4,21 @@ apply plugin: 'org.telegram.build-app-plugin'
+// Release credentials are never inherited from Telegram's sample keystore.
+// Keep vsvd-signing.properties in the VSVD repository root (ignored by Git).
+def vsvdSigning = new Properties()
+def vsvdSigningFile = new File(rootProject.projectDir.parentFile, "vsvd-signing.properties")
+if (vsvdSigningFile.exists()) {
+    vsvdSigningFile.withInputStream { vsvdSigning.load(it) }
+}
+def vsvdReleaseRequested = gradle.startParameter.taskNames.any { task ->
+    String name = task.toLowerCase()
+    name.contains("release") || name.contains("standalone")
+}
+def vsvdSigningFields = ["VSVD_RELEASE_STORE_FILE", "VSVD_RELEASE_STORE_PASSWORD", "VSVD_RELEASE_KEY_ALIAS", "VSVD_RELEASE_KEY_PASSWORD"]
+def vsvdSigningComplete = vsvdSigningFields.every { field -> vsvdSigning.getProperty(field, "").trim() }
+if (vsvdReleaseRequested && !vsvdSigningComplete) {
+    throw new GradleException("VSVD release requires ignored vsvd-signing.properties; see vsvd-signing.properties.example")
+}
+def vsvdReleaseStore = vsvdSigningComplete ? new File(rootProject.projectDir.parentFile, vsvdSigning.getProperty("VSVD_RELEASE_STORE_FILE")) : null
+if (vsvdReleaseRequested && !vsvdReleaseStore.isFile()) {
+    throw new GradleException("VSVD release keystore does not exist: " + vsvdReleaseStore)
+}
+
@@ -59,4 +80,5 @@ android {
-            storeFile file("../TMessagesProj/config/release.keystore")
-            storePassword RELEASE_STORE_PASSWORD
-            keyAlias RELEASE_KEY_ALIAS
-            keyPassword RELEASE_KEY_PASSWORD
+            // vsvdReleaseStore is required whenever a release/standalone task runs.
+            storeFile vsvdReleaseStore ?: file("../TMessagesProj/config/release.keystore")
+            storePassword vsvdSigningComplete ? vsvdSigning.getProperty("VSVD_RELEASE_STORE_PASSWORD") : RELEASE_STORE_PASSWORD
+            keyAlias vsvdSigningComplete ? vsvdSigning.getProperty("VSVD_RELEASE_KEY_ALIAS") : RELEASE_KEY_ALIAS
+            keyPassword vsvdSigningComplete ? vsvdSigning.getProperty("VSVD_RELEASE_KEY_PASSWORD") : RELEASE_KEY_PASSWORD
