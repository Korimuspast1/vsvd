index 0000000000000000000000000000000000000000..f465640750cf183bbde71249fab408cdbf0eb2e7
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdPluginPolicy.java
@@ -0,0 +1,73 @@
+/*
+ * VSVD additions to the Telegram Android GPLv2-or-later codebase.
+ */
+package org.telegram.vsvd;
+
+import java.util.Collections;
+import java.util.EnumSet;
+import java.util.Set;
+
+/**
+ * The first VSVD plugin runtime accepts signed declarative packages only.
+ * Dynamic APK, DEX, native libraries and arbitrary script engines are outside
+ * this contract by design.
+ */
+public final class VsvdPluginPolicy {
+
+    public enum Capability {
+        THEME,
+        MESSAGE_DECORATION,
+        CHAT_ACTION,
+        LOCAL_AUTOMATION,
+        NETWORK_REQUEST
+    }
+
+    private static final Set<Capability> PERMITTED = Collections.unmodifiableSet(
+        EnumSet.of(
+            Capability.THEME,
+            Capability.MESSAGE_DECORATION,
+            Capability.CHAT_ACTION,
+            Capability.LOCAL_AUTOMATION
+        )
+    );
+
+    private VsvdPluginPolicy() {
+    }
+
+    public static Validation validate(String id, int minClientVersion, int currentClientVersion, String publisherKeyId, String signature, Set<Capability> capabilities, Set<String> trustedPublisherKeys) {
+        if (id == null || !id.matches("[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*")) {
+            return Validation.reject("invalid_plugin_id");
+        }
+        if (minClientVersion > currentClientVersion) {
+            return Validation.reject("client_update_required");
+        }
+        if (publisherKeyId == null || trustedPublisherKeys == null || !trustedPublisherKeys.contains(publisherKeyId)) {
+            return Validation.reject("untrusted_publisher");
+        }
+        if (signature == null || signature.isEmpty()) {
+            return Validation.reject("missing_signature");
+        }
+        if (capabilities == null || !PERMITTED.containsAll(capabilities)) {
+            return Validation.reject("capability_not_allowed");
+        }
+        return Validation.accept();
+    }
+
+    public static final class Validation {
+        public final boolean accepted;
+        public final String reason;
+
+        private Validation(boolean accepted, String reason) {
+            this.accepted = accepted;
+            this.reason = reason;
+        }
+
+        private static Validation accept() {
+            return new Validation(true, "");
+        }
+
+        private static Validation reject(String reason) {
+            return new Validation(false, reason);
+        }
+    }
+}
