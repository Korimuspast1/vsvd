--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/vsvd/VsvdSettings.java
@@ -0,0 +1,78 @@
+/*
+ * VSVD additions to the Telegram Android GPLv2-or-later codebase.
+ */
+package org.telegram.vsvd;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.text.TextUtils;
+
+import org.telegram.messenger.BuildVars;
+
+/** Local, per-install settings for VSVD-only features. */
+public final class VsvdSettings {
+
+    private static final String PREFERENCES = "vsvd.settings.v1";
+    private static final String KEY_BADGES_VISIBLE = "badges_visible";
+    private static final String KEY_CONTROL_PLANE_ENABLED = "control_plane_enabled";
+    private static final String KEY_CONTROL_PLANE_URL = "control_plane_url";
+    private static final String KEY_PLUGIN_RUNTIME_ENABLED = "plugin_runtime_enabled";
+
+    private VsvdSettings() {
+    }
+
+    public static boolean areBadgesVisible(Context context) {
+        return preferences(context).getBoolean(KEY_BADGES_VISIBLE, true);
+    }
+
+    public static void setBadgesVisible(Context context, boolean visible) {
+        preferences(context).edit().putBoolean(KEY_BADGES_VISIBLE, visible).apply();
+    }
+
+    public static boolean isControlPlaneEnabled(Context context) {
+        return preferences(context).getBoolean(KEY_CONTROL_PLANE_ENABLED, false) && !TextUtils.isEmpty(getControlPlaneUrl(context));
+    }
+
+    public static void setControlPlaneEnabled(Context context, boolean enabled) {
+        preferences(context).edit().putBoolean(KEY_CONTROL_PLANE_ENABLED, enabled).apply();
+    }
+
+    public static String getControlPlaneUrl(Context context) {
+        return preferences(context).getString(KEY_CONTROL_PLANE_URL, "");
+    }
+
+    /**
+     * Accepts HTTPS only in release builds. HTTP is allowed in a debug build for
+     * an emulator/local server and must never be used for a distributed APK.
+     */
+    public static void setControlPlaneUrl(Context context, String value) {
+        String normalized = value == null ? "" : value.trim();
+        while (normalized.endsWith("/")) {
+            normalized = normalized.substring(0, normalized.length() - 1);
+        }
+        if (normalized.isEmpty()) {
+            preferences(context).edit().remove(KEY_CONTROL_PLANE_URL).apply();
+            return;
+        }
+        Uri uri = Uri.parse(normalized);
+        boolean acceptedScheme = "https".equalsIgnoreCase(uri.getScheme()) ||
+            (BuildVars.DEBUG_VERSION && "http".equalsIgnoreCase(uri.getScheme()));
+        if (!acceptedScheme || TextUtils.isEmpty(uri.getHost()) || !TextUtils.isEmpty(uri.getUserInfo()) || uri.getQuery() != null || uri.getFragment() != null) {
+            throw new IllegalArgumentException("Use a valid HTTPS Control Plane URL");
+        }
+        preferences(context).edit().putString(KEY_CONTROL_PLANE_URL, normalized).apply();
+    }
+
+    public static boolean isPluginRuntimeEnabled(Context context) {
+        return preferences(context).getBoolean(KEY_PLUGIN_RUNTIME_ENABLED, false);
+    }
+
+    public static void setPluginRuntimeEnabled(Context context, boolean enabled) {
+        preferences(context).edit().putBoolean(KEY_PLUGIN_RUNTIME_ENABLED, enabled).apply();
+    }
+
+    private static SharedPreferences preferences(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFERENCES, Context.MODE_PRIVATE);
+    }
+}
