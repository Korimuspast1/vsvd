# Server binding
PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Required to create the first administrator in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VSVD_BOOTSTRAP_TOKEN=

# Keep true behind HTTPS. Set to 0 only for local, non-production development.
VSVD_COOKIE_SECURE=1

# JSON data directory; replace this local store with PostgreSQL before public use.
VSVD_DATA_DIR=./data
